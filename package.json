    "odin-lang",
    "web-framework",
    "http-server",
    "orm",
    "template-engine",
    "cli",
    "scaffolding"
  ],
  "homepage": "https://github.com/Lvcky-gg/Gjallarhorn#readme",
  "bugs": "https://github.com/Lvcky-gg/Gjallarhorn/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lvcky-gg/Gjallarhorn.git"
  },
  "author": "John O'Donnell <mail@johnodonnell.xyz>",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
